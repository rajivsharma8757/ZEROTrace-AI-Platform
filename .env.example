# ZEROTrace AI — Frontend Environment Configuration Template
# SIH25070: Secure Data Wiping for Trustworthy IT Asset Recycling

# Application Configuration
VITE_APP_NAME="ZEROTrace AI"
VITE_APP_ENV="development"

# Backend REST API Base URL
VITE_API_URL="http://localhost:5000/api"

# Google Identity Services (OAuth 2.0 Web Client ID)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# If left empty, Google Sign-In displays configuration guidance and email/password remains active
VITE_GOOGLE_CLIENT_ID=""
