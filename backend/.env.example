# ZEROTrace AI Backend Environment Configuration Template
# SIH25070: Secure Data Wiping for Trustworthy IT Asset Recycling

# Application Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# JSON Web Token Secret
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zerotrace?schema=public

# Initial Sovereign Owner Account Bootstrap
OWNER_EMAIL=owner@zerotrace.ai
OWNER_INITIAL_PASSWORD=ChangeThisPassword123!

# Google OAuth 2.0 Credentials (Optional)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Must match VITE_GOOGLE_CLIENT_ID on the frontend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Email Configuration (Optional - Falls back to local data/email_outbox.json if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZEROTrace Security <noreply@zerotrace.ai>"
